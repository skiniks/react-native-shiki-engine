{
  "extends": "../../.config/typescript/tsconfig.expo.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    },
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*.ts", "../shared/**/*.tsx"],
  "exclude": ["android", "babel.config.js", "ios", "metro.config.js", "node_modules"]
}

  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/*.{test,spec}.{ts,tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "node_modules/typescript-7/bin/tsc"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "NativeShikiEngineSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "windows": {
      "namespace": "ShikiEngineCodegen",
      "outputDirectory": "windows/ShikiEngine/codegen",
      "separateDataTypes": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "pushRepo": "origin"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "chore(deps)",
              "section": "⬆️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            },
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "perf",
              "section": "🐎 Performance Improvements"
            }
          ]
        }
      }
    }
  }
